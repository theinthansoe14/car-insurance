<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Log ဖိုင်သိမ်းမည့် နေရာ -->
    <property name="LOG_FILE" value="logs/online.log"/>

    <!-- Console (Screen) ပေါ်တွင် JSON ဖြင့် ထွက်စေရန် -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%-5level","thread":"%thread","logger":"%logger{36}","message":"%msg"}%n</pattern>
        </encoder>
    </appender>

    <!-- Log ဖိုင်ထဲတွင် JSON ဖြင့် သိမ်းဆည်းရန် (5MB ပြည့်လျှင် ဖိုင်ခွဲမည်) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/online-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%-5level","thread":"%thread","logger":"%logger{36}","message":"%msg"}%n</pattern>
        </encoder>
    </appender>

    <!-- သင်၏ Package အတွက် TRACE အထိ Log များကို ဖွင့်ပေးခြင်း -->
    <logger name="com.tts.spring_security_code_test" level="TRACE"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>